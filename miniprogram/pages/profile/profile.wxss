/* pages/profile/profile.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #4d7bfe 0%, #6a8ffe 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edit-icon {
  font-size: 24rpx;
  opacity: 0.7;
}

.user-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.user-tags .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* 统计 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 1rpx 6rpx rgba(29, 33, 41, 0.05);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 4rpx;
}

/* 菜单 */
.menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(29, 33, 41, 0.05);
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1d2129;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c9cdd4;
}

/* 退出登录 */
.logout-btn {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #f25555;
  box-shadow: 0 1rpx 6rpx rgba(29, 33, 41, 0.05);
}

/* 版本 */
.version-text {
  text-align: center;
  font-size: 22rpx;
  color: #c9cdd4;
  margin-top: 40rpx;
}