/* app.wxss - 全局样式（Art Design Pro 配色体系） */
page {
  background: #f2f3f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.6;
}

/* 色彩变量 */
.color-primary { color: #4d7bfe; }
.color-success { color: #31c49c; }
.color-warning { color: #f0a020; }
.color-danger { color: #f25555; }
.color-info { color: #86909c; }

.bg-primary { background: #4d7bfe; }
.bg-success { background: #31c49c; }
.bg-warning { background: #f0a020; }
.bg-danger { background: #f25555; }

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 1rpx 6rpx rgba(29, 33, 41, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 16rpx;
}

/* 文字 */
.text-primary { color: #1d2129; }
.text-secondary { color: #4e5969; }
.text-tertiary { color: #86909c; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; font-weight: 600; }

/* 布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.tag-primary { background: rgba(77, 123, 254, 0.1); color: #4d7bfe; }
.tag-success { background: rgba(49, 196, 156, 0.1); color: #31c49c; }
.tag-warning { background: rgba(240, 160, 32, 0.1); color: #f0a020; }
.tag-danger { background: rgba(242, 85, 85, 0.1); color: #f25555; }
.tag-info { background: rgba(134, 144, 156, 0.1); color: #86909c; }

/* 按钮 */
.btn-primary {
  background: #4d7bfe;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }
.btn-outline {
  background: #ffffff;
  color: #4d7bfe;
  border: 2rpx solid #4d7bfe;
  border-radius: 12rpx;
  padding: 18rpx 38rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn-outline::after { border: none; }
.btn-danger {
  background: #f25555;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}
.btn-danger::after { border: none; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #86909c;
  font-size: 26rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #e5e6eb;
  margin: 16rpx 0;
}

/* 加载中 */
.loading-box {
  text-align: center;
  padding: 40rpx;
  color: #86909c;
  font-size: 24rpx;
}