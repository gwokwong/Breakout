/* pages/task-detail/task-detail.wxss */
.page {
  padding-bottom: 60rpx;
}

/* 头部 */
.detail-header {
  background: #ffffff;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  line-height: 1.5;
}

.header-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 阻塞警告 */
.blocked-alert {
  background: rgba(242, 85, 85, 0.06);
  border-left: 6rpx solid #f25555;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f25555;
  margin-bottom: 8rpx;
}

.alert-content {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.btn-unblock {
  display: inline-block;
  background: #31c49c;
  color: #ffffff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.5;
}
.btn-unblock::after { border: none; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #86909c;
}

.info-value {
  font-size: 26rpx;
  color: #1d2129;
  font-weight: 500;
}

/* 描述 */
.desc-content {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 操作区 */
.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.btn-action {
  flex: 1;
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  margin: 0;
}
.btn-action::after { border: none; }

/* 评论 */
.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #1d2129;
}

.comment-time {
  font-size: 22rpx;
  color: #c9cdd4;
}

.comment-content {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
  word-break: break-all;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 33, 41, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: 100%;
  height: 200rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-actions .btn-action {
  flex: 1;
  min-width: 0;
}