/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4d7bfe 0%, #6a8ffe 40%, #f2f3f5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

/* 品牌区 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.brand-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 操作区 */
.action-area {
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 微信登录按钮 */
.btn-wx {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #ffffff;
  color: #1d2129;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(29, 33, 41, 0.12);
}
.btn-wx::after { border: none; }
.btn-wx[disabled] { opacity: 0.7; }

/* 手机号登录 */
.phone-login {
  margin-top: 48rpx;
}

.divider-text {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-group input {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  color: #1d2129;
  box-sizing: border-box;
}

.phone-login .btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
}

/* 切换手机号登录 */
.switch-phone {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: underline;
}

/* 底部 */
.footer-text {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}