<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 品牌区 -->
  <view class="brand-area">
    <view class="brand-icon">破</view>
    <view class="brand-name">破局</view>
    <view class="brand-desc">轻量级阻塞驱动任务管理</view>
  </view>

  <!-- 操作区 -->
  <view class="action-area">
    <!-- 微信一键登录 -->
    <button class="btn-wx" bindtap="handleWxLogin" loading="{{loading}}" disabled="{{loading}}">
      微信一键登录
    </button>

    <!-- 手机号登录表单（微信登录失败时显示） -->
    <view class="phone-login" wx:if="{{showPhoneLogin}}">
      <view class="divider-text">或使用手机号登录</view>
      <form bindsubmit="handlePhoneLogin">
        <view class="input-group">
          <input name="phone" type="number" placeholder="请输入手机号" maxlength="11" />
        </view>
        <view class="input-group">
          <input name="password" type="text" password placeholder="请输入密码" />
        </view>
        <button class="btn-primary" form-type="submit" loading="{{loading}}" disabled="{{loading}}">
          登录
        </button>
      </form>
    </view>

    <!-- 切换到手机号登录 -->
    <view class="switch-phone" wx:else bindtap="setData" data-showPhoneLogin="{{true}}">
      使用手机号登录
    </view>
  </view>

  <!-- 底部协议 -->
  <view class="footer-text">
    登录即代表同意《用户协议》和《隐私政策》
  </view>
</view>