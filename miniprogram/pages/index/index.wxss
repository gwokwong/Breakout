/* pages/index/index.wxss */
.page {
  padding-bottom: 40rpx;
}

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.greeting-hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2129;
}

.greeting-sub {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 4rpx;
}

.greeting-bell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(29, 33, 41, 0.06);
}

.bell-icon {
  font-size: 36rpx;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #f25555;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 1rpx 6rpx rgba(29, 33, 41, 0.05);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stats-label {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}

.stats-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e5e6eb;
}

/* 卡片头 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

.title-icon {
  margin-right: 4rpx;
}

.card-extra {
  font-size: 24rpx;
}

/* 任务项 */
.task-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-item:last-child {
  border-bottom: none;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 28rpx;
  color: #1d2129;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.blocked-reason {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #f25555;
}

/* 项目项 */
.project-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.project-item:last-child {
  border-bottom: none;
}

.project-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d2129;
}

.project-desc {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}